{
  "name": "first-rank-coders-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "npm run build:libs && npm run build:apps",
    "build:user": "npm run build:libs && npm run build -w apps/user",
    "build:libs": "npm run build -w @firstrankcoders/shared",
    "build:apps": "npm run build -w apps/user && npm run build -w apps/auth && npm run build -w apps/contest",
    "start:apps": "npm run start -w apps/auth && npm run start -w apps/user && npm run start -w apps/contest",
    "start:user": "npm run start -w apps/user",
    "start:auth": "npm run start -w apps/auth",
    "start:org": "npm run start -w apps/organization",
    "build:org": "npm run build:libs && npm run build -w apps/organization",
    "dev:org": "npm run start:dev -w apps/organization",
    "dev:auth": "npm run start:dev -w apps/auth",
    "dev:user": "npm run start:dev -w apps/user",
    "start:contest": "npm run start -w apps/contest",
    "test": "npm run test -w apps/user",
    "clean": "rimraf \"{apps,libs}/**/dist\" \"{apps,libs}/**/node_modules\"",
    "install:all": "npm install && npm run build:libs"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "rimraf": "^5.0.5"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.x",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "swagger-ui-express": "^5.0.1"
  }
}
